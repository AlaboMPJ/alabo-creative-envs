ocio_profile_version: 2

environment:
  {}
search_path: luts
strictparsing: true
luma: [0.2126, 0.7152, 0.0722]

roles:
  color_picking: sRGB - Texture
  data: Raw
  default: ACEScg
  matte_paint: sRGB - Texture
  reference: ACEScg
  scene_linear: ACEScg
  texture_paint: sRGB - Texture

file_rules:
  - !<Rule> {name: Default, colorspace: default}

displays:
  sRGB:
    - !<View> {name: Standard, colorspace: sRGB - Display}

active_displays: [sRGB]
active_views: [Standard]

colorspaces:
  - !<ColorSpace>
    name: ACEScg
    family: ACES
    equalitygroup: ""
    bitdepth: 32f
    description: "Working space. Reference: declares no transform."
    isdata: false
    allocation: lg2
    allocationvars: [-8, 5, 0.00390625]

  - !<ColorSpace>
    name: Raw
    family: Utility
    equalitygroup: ""
    bitdepth: 32f
    description: Data. Never colour managed.
    isdata: true
    allocation: uniform
    to_scene_reference: !<ExponentTransform> {value: 2.2}

  - !<ColorSpace>
    name: sRGB - Texture
    family: Texture
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    allocation: uniform
    to_scene_reference: !<ExponentWithLinearTransform> {gamma: 2.4, offset: 0.055}

  - !<ColorSpace>
    name: sRGB - Display
    family: Display
    equalitygroup: ""
    bitdepth: 32f
    isdata: false
    allocation: uniform
    from_scene_reference: !<ExponentWithLinearTransform> {gamma: 2.4, offset: 0.055, direction: inverse}
